# Helms executable deployment package environment.
# Copy this file to .env before running docker compose.

# Base images. Override these if Docker Hub is unreachable in your network.
# Local smoke-test fallback can use locally available compatible tags, for example:
# HELMS_PYTHON_BASE_IMAGE=python:3.11-slim
# HELMS_NGINX_BASE_IMAGE=nginx:latest
HELMS_PYTHON_BASE_IMAGE=python:3.12-slim
HELMS_NGINX_BASE_IMAGE=nginx:alpine
HELMS_POSTGRES_IMAGE=postgres:15-alpine
HELMS_REDIS_IMAGE=redis:7-alpine
HELMS_MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z

# Public URL.
PUBLIC_BASE_URL=https://helms.example.com
CORS_ORIGINS=["https://helms.example.com"]
# Change this if 3008 is already used by an old local Clawith/Helms process.
FRONTEND_PORT=3008
API_UPSTREAM=backend:8000
MINIO_UPSTREAM=minio:9000
HELMS_DOCKER_NETWORK=helms_network

# Security. Replace every value before production use.
SECRET_KEY=replace-with-a-strong-random-secret
JWT_SECRET_KEY=replace-with-a-different-strong-random-secret

# Database.
POSTGRES_USER=helms
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=helms
DATABASE_URL=postgresql+asyncpg://helms:replace-with-a-strong-postgres-password@postgres:5432/helms

# Redis.
REDIS_URL=redis://redis:6379/0

# Durable Agent Runtime (required by Clawith v1.11.x).
AGENT_RUNTIME_COMMAND_CONCURRENCY=10
# Optional platform model UUIDs. Configure these in Platform Settings before
# using multi-Agent group planning or automatic shared-context compaction.
MULTI_AGENT_PLANNING_MODEL_ID=
MULTI_AGENT_COMPACT_MODEL_ID=

# Storage: local or s3.
STORAGE_BACKEND=local
STORAGE_LOCAL_FALLBACK_ENABLED=true
S3_BUCKET=helms
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=helms
S3_SECRET_ACCESS_KEY=replace-with-a-strong-minio-password
S3_PREFIX=agents

# MinIO. Used when starting with: docker compose --profile s3 up --build -d
MINIO_ROOT_USER=helms
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password

# Optional integrations.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
JINA_API_KEY=
EXA_API_KEY=
SANDBOX_TYPE=subprocess
SANDBOX_API_KEY=
SANDBOX_API_URL=
HTTP_PROXY=
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Optional China mirrors for backend image build.
# Example:
# CLAWITH_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
# CLAWITH_PIP_TRUSTED_HOST=mirrors.aliyun.com
CLAWITH_PIP_INDEX_URL=
CLAWITH_PIP_TRUSTED_HOST=
